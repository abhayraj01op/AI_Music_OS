# ============================================================
# STEP 7 — AUDIO GENERATION FUNCTION
# ============================================================

def generate_audio(
    text,
    voice="af_heart",
    speed=1.0,
    output_name=None
):
    """
    Generate real Kokoro speech.

    Parameters
    ----------
    text : str
        Input text.
    voice : str
        Kokoro voice name.
    speed : float
        Speech speed.
    output_name : str | None
        Optional output filename.

    Returns
    -------
    str
        Saved WAV path.
    """

    text = (text or "").strip()

    if not text:
        raise ValueError("Text is empty.")

    if voice not in VOICE_CHOICES:
        raise ValueError(
            f"Unknown voice: {voice}\n"
            f"Available voices: {VOICE_CHOICES}"
        )

    try:
        speed = float(speed)
    except Exception:
        raise ValueError("Speed must be a number.")

    if speed <= 0:
        raise ValueError("Speed must be greater than 0.")

    print()
    print("-" * 70)
    print("Generating audio")
    print("-" * 70)
    print("Voice:", voice)
    print("Speed:", speed)
    print("Text:", text[:300])
    print()

    chunks = []

    # Official Kokoro API:
    # pipeline(...) -> (graphemes, phonemes, audio)
    generator = pipeline(
        text,
        voice=voice,
        speed=speed
    )

    for index, item in enumerate(generator):

        if not isinstance(item, tuple) or len(item) < 3:
            raise RuntimeError(
                "Unexpected Kokoro output format:\n"
                f"{type(item)}\n"
                f"{repr(item)[:1000]}"
            )

        graphemes, phonemes, audio = item

        print(
            f"Chunk {index + 1}: "
            f"graphemes={len(graphemes)}, "
            f"phonemes={len(phonemes)}"
        )

        if audio is None:
            raise RuntimeError(
                f"Kokoro returned empty audio for chunk {index + 1}."
            )

        chunks.append(
            np.asarray(audio, dtype=np.float32)
        )

    if not chunks:
        raise RuntimeError(
            "Kokoro returned no audio chunks."
        )

    audio = np.concatenate(chunks)

    if audio.size == 0:
        raise RuntimeError(
            "Generated audio is empty."
        )

    # Kokoro official examples use 24 kHz output.
    sample_rate = 24000

    if output_name:

        safe_name = str(output_name)

        if not safe_name.lower().endswith(".wav"):
            safe_name += ".wav"

        output_path = OUTPUT_DIR / safe_name

    else:

        timestamp = int(time.time())

        output_path = OUTPUT_DIR / (
            f"kokoro_{timestamp}.wav"
        )

    sf.write(
        str(output_path),
        audio,
        sample_rate
    )

    if not output_path.exists():
        raise RuntimeError(
            "Audio file was not created."
        )

    file_size = output_path.stat().st_size

    if file_size < 1000:
        raise RuntimeError(
            "Generated WAV file is suspiciously small."
        )

    print()
    print("SUCCESS")
    print("File:", output_path)
    print("Size:", file_size, "bytes")
    print("Sample rate:", sample_rate)
    print("Samples:", len(audio))
    print("Duration:", round(len(audio) / sample_rate, 2), "sec")
    print("-" * 70)

    return str(output_path)


