# ============================================================
# STEP 3 — PYTHON PACKAGE INSTALLATION
# ============================================================

print("=" * 70)
print("Preparing Python packages")
print("=" * 70)

def run_pip(args, name):
    """
    Run pip and show the real error instead of hiding it.
    """
    command = [sys.executable, "-m", "pip"] + args

    print()
    print(">>>", name)
    print(">>>", " ".join(command))
    print()

    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True
    )

    print(result.stdout)

    if result.returncode != 0:
        raise RuntimeError(
            f"\n{name} FAILED.\n"
            f"Exit code: {result.returncode}\n"
            f"See the full pip output above."
        )

    print(f"\n{name}: OK\n")


# ------------------------------------------------------------
# 3A — Upgrade pip tooling
# ------------------------------------------------------------

run_pip(
    [
        "install",
        "-U",
        "pip",
        "setuptools",
        "wheel"
    ],
    "Upgrade pip/setuptools/wheel"
)


# ------------------------------------------------------------
# 3B — Install Misaki
#
# PyPI Misaki 0.9.4 still declares Python <3.13.
# Therefore on Python 3.13 we install the current upstream
# source separately instead of combining it with Kokoro.
# ------------------------------------------------------------

if sys.version_info >= (3, 13):

    print("Python 3.13+ detected.")
    print("Using upstream Misaki source.")
    print()

    # Install Misaki dependencies first
    run_pip(
        [
            "install",
            "-U",
            "numpy",
            "num2words",
            "spacy",
            "loguru"
        ],
        "Install Misaki runtime dependencies"
    )

    # Install current Misaki source separately
    run_pip(
        [
            "install",
            "-U",
            "--no-cache-dir",
            "git+https://github.com/hexgrad/misaki.git"
        ],
        "Install Misaki from official GitHub"
    )

else:

    print("Python <= 3.12 detected.")
    print("Using stable PyPI Misaki.")
    print()

    run_pip(
        [
            "install",
            "-U",
            "misaki[en]>=0.9.4"
        ],
        "Install Misaki from PyPI"
    )


# ------------------------------------------------------------
# 3C — Install Kokoro
#
# IMPORTANT:
# We install the source package with --no-deps.
# Dependencies are already installed/managed separately.
#
# This avoids the Python 3.13 dependency resolver problem
# encountered in the previous version.
# ------------------------------------------------------------

if sys.version_info >= (3, 13):

    run_pip(
        [
            "install",
            "-U",
            "--no-cache-dir",
            "--no-deps",
            "git+https://github.com/hexgrad/kokoro.git"
        ],
        "Install Kokoro from official GitHub"
    )

else:

    run_pip(
        [
            "install",
            "-U",
            "kokoro>=0.9.4"
        ],
        "Install Kokoro from PyPI"
    )


# ------------------------------------------------------------
# 3D — Core Kokoro dependencies
# ------------------------------------------------------------

run_pip(
    [
        "install",
        "-U",
        "huggingface_hub",
        "transformers",
        "soundfile",
        "numpy"
    ],
    "Install Kokoro runtime dependencies"
)


